{
  "datasets": [
    {
      "name": "ds_sales",
      "displayName": "Omnichannel sales (gold)",
      "queryLines": [
        "SELECT sale_date, channel, country, ip_name, product_type, units, revenue, line_count FROM gold_sales_daily "
      ],
      "columns": [
        {
          "displayName": "Total Revenue",
          "description": "Sum of gross revenue",
          "expression": "SUM(`revenue`)"
        },
        {
          "displayName": "Total Units",
          "description": "Sum of units sold",
          "expression": "SUM(`units`)"
        },
        {
          "displayName": "Sales Lines",
          "description": "Number of sale lines",
          "expression": "SUM(`line_count`)"
        }
      ],
      "catalog": "popmart",
      "schema": "default"
    },
    {
      "name": "ds_ip",
      "displayName": "IP performance",
      "queryLines": [
        "SELECT ip_name, artist_name, total_revenue, total_units, online_revenue, offline_revenue, num_products FROM gold_ip_performance ORDER BY total_revenue DESC LIMIT 10 "
      ],
      "catalog": "popmart",
      "schema": "default"
    },
    {
      "name": "ds_secret",
      "displayName": "Secret-hit rates",
      "queryLines": [
        "SELECT ip_name, series_name, expected_ratio, total_draws, secret_hits, actual_hit_rate FROM gold_secret_hit_rates "
      ],
      "columns": [
        {
          "displayName": "Overall Hit Rate",
          "description": "Secret hits / total draws",
          "expression": "SUM(`secret_hits`)*1.0/SUM(`total_draws`)"
        },
        {
          "displayName": "Total Draws",
          "description": "Total blind-box draws",
          "expression": "SUM(`total_draws`)"
        }
      ],
      "catalog": "popmart",
      "schema": "default"
    },
    {
      "name": "ds_tier",
      "displayName": "Membership tiers",
      "queryLines": [
        "SELECT membership_tier, num_members, avg_ltv, total_revenue, omnichannel_pct FROM gold_member_tier_summary "
      ],
      "catalog": "popmart",
      "schema": "default"
    },
    {
      "name": "ds_store",
      "displayName": "Store performance",
      "queryLines": [
        "SELECT store_id, store_name, store_type, country, city, revenue, units, txns, avg_basket FROM gold_store_performance ORDER BY revenue DESC LIMIT 25 "
      ],
      "catalog": "popmart",
      "schema": "default"
    },
    {
      "name": "ds_inventory",
      "displayName": "Inventory health",
      "queryLines": [
        "SELECT store_id, store_name, store_type, country, num_skus, stockouts, below_reorder, stockout_rate FROM gold_inventory_health "
      ],
      "columns": [
        {
          "displayName": "Avg Stockout Rate",
          "description": "Average stockout rate (fraction)",
          "expression": "AVG(`stockout_rate`)/100"
        }
      ],
      "catalog": "popmart",
      "schema": "default"
    },
    {
      "name": "ds_omni",
      "displayName": "Omnichannel customers",
      "queryLines": [
        "SELECT member_id, membership_tier, country, online_spend, offline_spend, total_spend, is_omnichannel FROM gold_omnichannel_customer "
      ],
      "columns": [
        {
          "displayName": "Omnichannel Rate",
          "description": "Share of members buying online AND in-store",
          "expression": "SUM(CASE WHEN `is_omnichannel`=true THEN 1 ELSE 0 END)*1.0/COUNT(`member_id`)"
        }
      ],
      "catalog": "popmart",
      "schema": "default"
    },
    {
      "name": "ds_supply",
      "displayName": "Supply chain",
      "queryLines": [
        "SELECT supplier_name, supplier_country, category, num_pos, total_cost, avg_actual_lead_days, avg_expected_lead_days FROM gold_supply_chain_supplier ORDER BY total_cost DESC LIMIT 12 "
      ],
      "catalog": "popmart",
      "schema": "default"
    }
  ],
